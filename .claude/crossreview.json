{
  "version": 1,
  "min_reviewers": 2,
  "timeout": 2700,
  "reviewers": [
    {
      "kind": "cli",
      "agent": "coddy",
      "binary": "coddy",
      "command": "coddy --model cdxrgm/gpt-6.1-sol --mode ask --no-stdin -i {brief} > {out}",
      "model": "cdxrgm/gpt-6.1-sol"
    },
    {
      "kind": "cli",
      "agent": "coddy",
      "binary": "coddy",
      "command": "coddy --model neuraldeep/gemma-4-31b --mode ask --no-stdin -i {brief} > {out}",
      "model": "neuraldeep/gemma-4-31b"
    },
    {
      "kind": "cli",
      "agent": "coddy",
      "binary": "coddy",
      "command": "coddy --model neuraldeep/qwen3.8-27b --mode ask --no-stdin -i {brief} > {out}",
      "model": "neuraldeep/qwen3.8-27b"
    }
  ]
}
